{
  "name": "mtbi-research",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "mTBIResearch.com \u2014 Mild Traumatic Brain Injury Keystone Research Study",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "node scripts/prerender.mjs",
    "seo": "node scripts/generate-seo-files.mjs",
    "verify": "node scripts/verify-prerender.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:server && npm run prerender && npm run seo && npm run verify",
    "preview": "vite preview --outDir dist/client"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "marked": "^15.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  }
}
